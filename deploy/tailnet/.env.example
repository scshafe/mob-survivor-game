# Copy to .env (git ignores it) and fill in. Never commit the real key.
#
# An auth key from https://login.tailscale.com/admin/settings/keys
# (reusable is not needed; a tag such as tag:game is a good idea).
TS_AUTHKEY=tskey-auth-REPLACE-ME

# Optional extra `tailscale up` flags, e.g. --advertise-tags=tag:game
TS_EXTRA_ARGS=
